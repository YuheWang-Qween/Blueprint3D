# Set these in your hosting provider. Shell scripts do not load .env files.
PORT=5000
BLUEPRINT_DATA_DIR=/data/blueprint3d
# Enable only behind HTTPS. For the Coze HTTPS preview iframe, also set SameSite=none.
BLUEPRINT_SECURE_COOKIES=1
BLUEPRINT_COOKIE_SAMESITE=lax
# Requires the full inference dependencies and appropriately licensed weights.
BLUEPRINT_ENABLE_NEURAL=0
